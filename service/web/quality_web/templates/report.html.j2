{% extends "base.html.j2" %}
{% macro code(text) %}<code>{{ text }}</code>{% endmacro %}
{% block title %}{{ t("report.title") }}{% endblock %}
{% block main %}
<h1>{{ t("report.title") }}</h1>
{% if report.status != "done" %}
<p class="failed">{{ t("report.failed", reason=report.reason) }}</p>
<p>{{ t("report.not_scanned") }}</p>
{% else %}
<dl class="header">
  {% if report.commit %}<dt>{{ t("report.commit") }}</dt><dd>{{ code(report.commit) }}</dd>{% endif %}
  <dt>quality</dt><dd>{{ report.quality }}</dd>
  <dt>{{ t("report.database") }}</dt><dd>{% if report.database %}{% if report.database.digest %}{{ t("report.database_digest", date=report.database.updated, digest=code(report.database.digest)) }}{% else %}{{ t("report.database_updated", date=report.database.updated) }}{% endif %}{% else %}{{ t("report.database_unused") }}{% endif %}</dd>
  {% if report.history %}<dt>{{ t("report.history") }}</dt><dd>{{ report.history }}</dd>{% endif %}
</dl>
<p>{{ t("report.findings", count=report.result.findings | length) }}</p>
{% if report.result.findings %}
<table>
  <thead><tr><th>{{ t("report.severity") }}</th><th>{{ t("report.rule") }}</th><th>{{ t("report.location") }}</th><th>{{ t("report.summary") }}</th></tr></thead>
  <tbody>
  {% for finding in report.result.findings %}
  <tr>
    <td>{{ finding.severity }}</td>
    <td><code>{{ finding.rule }}</code></td>
    <td><code>{{ finding.path }}{% if finding.line is not none %}:{{ finding.line }}{% endif %}</code></td>
    <td>{{ finding.summary }}{% if finding.value is not none %} ({{ finding.value }}){% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
<h2>{{ t("report.exclusions") }}</h2>
{% if report.result.ignored or report.result.nocheck %}
<ul>
  {% for entry in report.result.ignored %}<li>{{ t("report.ignored", rule=code(entry.rule), paths=entry.paths | join(", ") or t("report.whole_project"), reason=entry.reason) }}</li>{% endfor %}
  {% for entry in report.result.nocheck %}<li>{{ t("report.suppressed", rule=code(entry.rule), location=code(entry.path ~ ":" ~ entry.line)) }}</li>{% endfor %}
</ul>
{% else %}
<p>{{ t("report.none") }}</p>
{% endif %}
{% if report.result.incomplete or report.result.unchecked %}
<h2>{{ t("report.unchecked") }}</h2>
<ul>
  {% for rule in report.result.incomplete %}<li>{{ t("report.rule_skipped", rule=code(rule)) }}</li>{% endfor %}
  {% for path in report.result.unchecked %}<li>{{ t("report.oversized", path=code(path)) }}</li>{% endfor %}
</ul>
{% endif %}
{% endif %}
{% endblock %}
