{% extends "base.html.j2" %}
{% block head %}
{% if form and form.challenge %}
<link rel="stylesheet" href="{{ url_for('static', filename='altcha/altcha.css') }}">
<script type="module" src="{{ url_for('static', filename='captcha.js') }}"></script>
{% endif %}
{% endblock %}
{% block main %}
<h1>{{ t("index.title") }}</h1>
<p>{{ t("index.intro", tool="<code>quality</code>" | safe) }}</p>
{% if form %}
<form method="post" action="{{ form.action }}" enctype="multipart/form-data">
  <fieldset>
    <legend>{{ t("index.legend") }}</legend>
    <label><input type="radio" name="kind" value="url" checked> {{ t("index.url") }}</label>
    <input type="url" name="url" placeholder="https://github.com/owner/repository" pattern="https://.*">
    <label><input type="radio" name="kind" value="file"> {{ t("index.file", kib=form.upload_bytes // 1024) }}</label>
    <input type="file" name="file">
    <label><input type="radio" name="kind" value="text"> {{ t("index.text") }}</label>
    <select name="language">
      {% for language in form.languages %}<option value="{{ language }}">{{ language }}</option>{% endfor %}
    </select>
    <textarea name="text" rows="12" spellcheck="false"></textarea>
  </fieldset>
  {% if form.challenge %}
  <altcha-widget challenge="{{ form.challenge }}" name="altcha"></altcha-widget>
  {% endif %}
  <button type="submit">{{ t("index.submit") }}</button>
</form>
{% else %}
<p>{{ t("index.login_required") }}</p>
{% endif %}
{% endblock %}
