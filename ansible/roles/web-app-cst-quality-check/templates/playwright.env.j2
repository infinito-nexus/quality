ADMIN_PASSWORD={{ lookup('users', 'platform_administrator').password | dotenv_quote }}
ADMIN_USERNAME={{ lookup('users', 'platform_administrator').username | dotenv_quote }}
ANONYMOUS_ENABLED={{ lookup('config', application_id, 'services.quality-check.access.anonymous') | string | lower }}
APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}
BIBER_PASSWORD={{ lookup('users', 'biber').password | dotenv_quote }}
BIBER_USERNAME={{ lookup('users', 'biber').username | dotenv_quote }}
CAPTCHA_ENABLED={{ lookup('config', application_id, 'services.quality-check.access.captcha') | string | lower }}
CDN_BASE_URL={{ lookup('landing_url', 'web-svc-cdn') | dotenv_quote }}
KEYCLOAK_ADMIN_CLI_CLIENT_ID={{ OIDC.ADMIN.CLI_CLIENT_ID | dotenv_quote }}
KEYCLOAK_ADMIN_REALM={{ OIDC.ADMIN.REALM | dotenv_quote }}
KEYCLOAK_BASE_URL={{ OIDC.URL | dotenv_quote }}
KEYCLOAK_REALM_NAME={{ OIDC.CLIENT.REALM | dotenv_quote }}
NODE_TLS_REJECT_UNAUTHORIZED=0
# nocheck: persona-block-rationale  the app's tiers hang on the role group, which the shared flow cannot set; the spec's administrator: and biber: tests log in through Keycloak with the membership each tier needs
PERSONA_ADMINISTRATOR_BLOCKED=true
# nocheck: persona-block-rationale  the app's tiers hang on the role group, which the shared flow cannot set; the spec's administrator: and biber: tests log in through Keycloak with the membership each tier needs
PERSONA_BIBER_BLOCKED=true
# nocheck: persona-block-rationale  the anonymous flow is the spec itself
PERSONA_GUEST_BLOCKED=true
RBAC_MEMBER_GROUP_PATH={{ QUALITY_CHECK_OIDC.member_group | dotenv_quote }}
REGISTERED_PER_USER_HOUR={{ lookup('config', application_id, 'services.quality-check.rate_limits.registered_per_user_hour') }}
REPOSITORY_URL=https://github.com/infinito-nexus/quality
SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
SUPER_ADMIN_PASSWORD={{ (OIDC.ADMIN.PASSWORD | dotenv_quote) if (lookup('config', application_id, 'services.sso.enabled') | bool) else '""' }}
SUPER_ADMIN_USERNAME={{ (OIDC.ADMIN.USERNAME | dotenv_quote) if (lookup('config', application_id, 'services.sso.enabled') | bool) else '""' }}
UNREACHABLE_REPOSITORY_URL=https://quality-check.invalid/limit
