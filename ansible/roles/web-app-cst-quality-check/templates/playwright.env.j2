ANONYMOUS_ENABLED={{ lookup('config', application_id, 'services.quality-check.access.anonymous') | string | lower }}
APP_BASE_URL={{ lookup('tls', application_id, 'url.base') }}
CAPTCHA_ENABLED={{ lookup('config', application_id, 'services.quality-check.access.captcha') | string | lower }}
NODE_TLS_REJECT_UNAUTHORIZED=0
# nocheck: persona-block-rationale  member and registered logins are proven by the token tests of the web app; the first deploy round runs without Keycloak
PERSONA_ADMINISTRATOR_BLOCKED=true
# nocheck: persona-block-rationale  member and registered logins are proven by the token tests of the web app; the first deploy round runs without Keycloak
PERSONA_BIBER_BLOCKED=true
# nocheck: persona-block-rationale  the anonymous flow is the spec itself
PERSONA_GUEST_BLOCKED=true
SSO_SERVICE_ENABLED={{ lookup('config', application_id, 'services.sso.enabled') | string | lower }}
